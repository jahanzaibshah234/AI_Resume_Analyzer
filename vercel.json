{
  "version": 2,
  "builds": [
    {
      "src": "resume_project/main.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "resume_project/**",
        "maxDuration": 30
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", 
      "dest": "resume_project/main.py" 
    }
  ]
}
